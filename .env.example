# =========================================================
# VARIABLES DE ENTORNO FRONTEND (LOCAL Y RAILWAY)
# =========================================================

# URL Base principal para Login contra DB propia y consumo de API
# En desarrollo local con proxy de Vite puede ser "/api" o "http://localhost:8080/api"
# En Railway apuntar a la URL pública de tu servicio (ej: "https://tu-backend.up.railway.app/api")
VITE_URL_BASE=/api

# Opcional: Ruta específica o URL completa del endpoint POST de Login (por defecto usa ${VITE_URL_BASE}/auth/login)
# VITE_AUTH_LOGIN_PATH=/api/auth/login

# Opcional: Si el servicio de integración de Google (doc-api) corre en una URL distinta a VITE_URL_BASE en Railway
# VITE_GOOGLE_API_URL=https://doc-api-production.up.railway.app/api

