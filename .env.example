# =========================================================
# VARIABLES DE ENTORNO FRONTEND (LOCAL Y RAILWAY)
# =========================================================

# URL Base del Servidor Backend (SIN /api al final)
# - En desarrollo local: dejar vacío "" para usar el proxy de Vite en '/api'
# - En Railway: colocar la URL del servicio (ej: "https://tu-backend.up.railway.app")
VITE_URL_BASE=

# Opcional: Ruta personalizada para el endpoint de Login si es diferente a ${VITE_URL_BASE}/api/auth/login
# VITE_AUTH_LOGIN_PATH=

# Opcional: Host específico para Google API si estuviera separado (SIN /api)
# VITE_GOOGLE_API_URL=
